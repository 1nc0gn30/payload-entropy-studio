[Desktop Entry]
Version=1.0
Type=Application
Name=Payload & Entropy Studio
GenericName=Payload Entropy Analyzer & Threat Classifier
Comment=Zero-Trust Shannon & Chi-Square Payload Entropy Analyzer, Threat Classifier & Deobfuscator
Exec=/usr/local/bin/payload-entropy desktop
Icon=/media/neo/f2fdda77-178b-4603-ae80-c7aa4cd97908/zoth-micro-repos/payload-entropy-studio/assets/icon.png
Terminal=false
Categories=Security;Development;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open Payload Entropy CLI
Exec=x-terminal-emulator -e "/usr/local/bin/payload-entropy --help"

[Desktop Action Web]
Name=Open Web UI (Port 8095)
Exec=/usr/local/bin/payload-entropy web
